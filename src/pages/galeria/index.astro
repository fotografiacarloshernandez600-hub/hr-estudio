---
export const prerender = false;
---
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Tu galería | HR Estudio</title>
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style is:global>
    :root {
      --negro: #161412; --carbon: #1F1C19; --carbon-2: #26221E;
      --crema: #F4EFE6; --humo: #9B948A; --oro: #C5A059; --oro-claro: #E2C98F;
      --borde: rgba(197, 160, 89, 0.25);
    }
    * { box-sizing: border-box; }
    body {
      margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;
      position: relative; overflow: hidden;
      background: var(--negro); color: var(--crema); font-family: 'Inter', sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    body::before {
      content: "";
      position: absolute; inset: 0;
      background: radial-gradient(ellipse 700px 500px at 50% 30%, rgba(197,160,89,0.12), transparent 70%);
      pointer-events: none;
    }
    .card {
      position: relative; z-index: 1;
      width: 100%; max-width: 440px;
      padding: 56px 40px;
      margin: 24px;
      background: var(--carbon);
      border: 1px solid var(--borde);
      border-radius: 6px;
      text-align: center;
      opacity: 0; transform: translateY(16px);
      animation: entrar 0.6s ease forwards;
      box-shadow: 0 30px 80px rgba(0,0,0,0.4);
    }
    @keyframes entrar { to { opacity: 1; transform: translateY(0); } }

    .marca {
      font-size: 11px; letter-spacing: 3px; text-transform: uppercase; color: var(--humo);
      margin: 0 0 24px;
    }
    .icono {
      width: 44px; height: 44px; margin: 0 auto 20px;
      border: 1px solid var(--oro); border-radius: 50%;
      display: flex; align-items: center; justify-content: center; color: var(--oro);
    }
    .icono svg { width: 20px; height: 20px; }

    h1 {
      font-family: 'Playfair Display', serif; font-weight: 600; font-style: italic;
      font-size: 30px; margin: 0 0 10px; color: var(--crema);
    }
    p.sub {
      color: var(--humo); font-size: 14px; line-height: 1.7; margin: 0 0 32px;
    }

    .campo { position: relative; margin-bottom: 16px; text-align: left; }
    label {
      display: block; font-size: 11px; letter-spacing: 1px; text-transform: uppercase;
      color: var(--humo); margin-bottom: 8px;
    }
    input {
      width: 100%; padding: 15px 16px; font-size: 17px; letter-spacing: 1.5px;
      font-family: 'Inter', sans-serif; text-align: center; text-transform: uppercase;
      background: var(--carbon-2); color: var(--crema);
      border: 1px solid var(--borde); border-radius: 4px;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    input:focus { outline: none; border-color: var(--oro); box-shadow: 0 0 0 3px rgba(197,160,89,0.15); }
    input::placeholder { color: var(--humo); letter-spacing: 1px; text-transform: none; }

    button {
      width: 100%; padding: 15px 16px; font-size: 13px; letter-spacing: 1.2px;
      text-transform: uppercase; font-weight: 500;
      font-family: 'Inter', sans-serif;
      background: var(--oro); color: var(--negro);
      border: none; border-radius: 4px; cursor: pointer;
      transition: background 0.2s, transform 0.15s;
      margin-top: 8px;
    }
    button:hover:not(:disabled) { background: var(--oro-claro); transform: translateY(-1px); }
    button:disabled { opacity: 0.5; cursor: default; transform: none; }

    .error {
      color: #E2857A; font-size: 13px; margin: 4px 0 14px; text-align: left;
    }

    .ayuda {
      margin-top: 28px; padding-top: 24px; border-top: 1px solid var(--borde);
      font-size: 12px; color: var(--humo); line-height: 1.6;
    }
    .ayuda a { color: var(--oro-claro); text-decoration: none; }
    .ayuda a:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <main class="card">
    <p class="marca">HR Estudio</p>
    <div class="icono">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="M21 15l-5-5L5 21"/></svg>
    </div>
    <h1>Tu galería</h1>
    <p class="sub">Ingresa el código que te compartimos por WhatsApp para ver y descargar tus fotos.</p>

    <form id="form-codigo">
      <div class="campo">
        <label for="codigo">Código de acceso</label>
        <input type="text" id="codigo" placeholder="HR-8F2K3A" autocomplete="off" autocapitalize="characters" autofocus />
      </div>
      <p class="error" id="error-msg" style="display:none;"></p>
      <button type="submit" id="btn-submit">Ver mi galería</button>
    </form>

    <p class="ayuda">¿No tienes tu código? Escríbenos por <a href="https://wa.me/529331641201" target="_blank" rel="noopener">WhatsApp</a> y te lo compartimos de nuevo.</p>
  </main>

  <script>
    const form = document.getElementById("form-codigo") as HTMLFormElement;
    const input = document.getElementById("codigo") as HTMLInputElement;
    const btn = document.getElementById("btn-submit") as HTMLButtonElement;
    const errorMsg = document.getElementById("error-msg") as HTMLParagraphElement;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      errorMsg.style.display = "none";
      btn.disabled = true;
      btn.textContent = "Verificando…";

      try {
        const res = await fetch("/api/gallery/verify", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ codigo: input.value }),
        });
        const data = await res.json();

        if (!res.ok) {
          errorMsg.textContent = data.error ?? "No se pudo validar el código";
          errorMsg.style.display = "block";
          return;
        }

        sessionStorage.setItem(`galeria_token_${data.evento.id}`, data.token);
        window.location.href = `/galeria/${data.evento.id}`;
      } catch {
        errorMsg.textContent = "Ocurrió un problema. Intenta de nuevo.";
        errorMsg.style.display = "block";
      } finally {
        btn.disabled = false;
        btn.textContent = "Ver mi galería";
      }
    });
  </script>
</body>
</html>
