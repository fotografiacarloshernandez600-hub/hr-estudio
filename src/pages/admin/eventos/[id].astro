---
export const prerender = false;
import { supabaseAdmin } from "../../../lib/supabase";
import { urlDescargaTemporal } from "../../../lib/storage";

const { id } = Astro.params;

const { data: evento } = await supabaseAdmin
  .from("events")
  .select("*")
  .eq("id", id)
  .single();

let fotos: any[] = [];
if (evento) {
  const { data } = await supabaseAdmin
    .from("photos")
    .select("id, thumbnail_key, nombre_archivo, creado_en")
    .eq("event_id", id)
    .order("creado_en", { ascending: false });

  fotos = await Promise.all(
    (data ?? []).map(async (f) => ({
      ...f,
      thumb_url: f.thumbnail_key ? await urlDescargaTemporal(f.thumbnail_key, 3600) : null,
    }))
  );
}
---
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{evento?.nombre ?? "Evento"} | Admin HR Estudio</title>
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;1,400&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
  {evento?.tipo === "carrera" && (
    <script src="https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/dist/face-api.min.js" is:inline></script>
  )}
  <style is:global>
    :root {
      --negro: #161412; --carbon: #1F1C19; --carbon-2: #26221E;
      --crema: #F4EFE6; --humo: #9B948A; --oro: #C5A059; --oro-claro: #E2C98F;
      --borde: rgba(197, 160, 89, 0.25);
    }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--negro); color: var(--crema); font-family: 'Inter', sans-serif; }
    .container { max-width: 1000px; margin: 0 auto; padding: 40px 24px 80px; }
    a.volver { color: var(--humo); text-decoration: none; font-size: 13px; display: inline-block; margin-bottom: 16px; }
    a.volver:hover { color: var(--oro); }
    h1 { font-family: 'Playfair Display', serif; font-weight: 600; font-size: 26px; margin: 0 0 4px; }
    .meta { color: var(--humo); font-size: 14px; margin-bottom: 24px; }
    .panel { background: var(--carbon); border: 1px solid var(--borde); border-radius: 4px; padding: 28px; margin-bottom: 28px; }
    .panel h2 { font-family: 'Playfair Display', serif; font-weight: 600; font-size: 17px; margin: 0 0 16px; }
    .codigo-box { display: flex; align-items: center; gap: 12px; background: var(--carbon-2); border: 1px solid var(--borde); border-radius: 4px; padding: 16px 20px; margin-bottom: 8px; }
    .codigo-box code { font-size: 20px; letter-spacing: 1px; color: var(--oro-claro); }
    .codigo-box button { margin-left: auto; background: none; border: 1px solid var(--borde); color: var(--humo); padding: 6px 12px; border-radius: 4px; cursor: pointer; font-size: 12px; }
    .codigo-box button:hover { color: var(--crema); border-color: var(--oro); }
    .link-galeria { font-size: 13px; color: var(--humo); }
    .link-galeria a { color: var(--oro-claro); }
    .btn-whatsapp {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 10px 18px; margin-bottom: 14px; font-size: 13px; font-weight: 500;
      background: #25D366; color: #0b1a10; border-radius: 4px; text-decoration: none;
      transition: background 0.2s;
    }
    .btn-whatsapp:hover { background: #2fe374; }

    .dropzone { border: 1px dashed var(--borde); border-radius: 4px; padding: 32px; text-align: center; color: var(--humo); font-size: 14px; cursor: pointer; }
    .dropzone:hover { border-color: var(--oro); color: var(--crema); }
    input[type=file] { display: none; }
    .estado-subida { font-size: 13px; color: var(--humo); margin-top: 12px; }
    .estado-subida.ok { color: var(--oro-claro); }
    .estado-subida.error { color: #E2857A; }

    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 12px; margin-top: 20px; }
    .foto-item { position: relative; }
    .foto-item img { width: 100%; aspect-ratio: 1/1; object-fit: cover; border-radius: 4px; border: 1px solid var(--borde); background: var(--carbon-2); display: block; }
    .foto-item.borrando img { opacity: 0.4; }
    .btn-borrar {
      position: absolute; top: 6px; right: 6px; width: 26px; height: 26px; border-radius: 50%;
      background: rgba(22,20,18,0.8); border: 1px solid var(--borde); color: var(--crema);
      cursor: pointer; font-size: 14px; line-height: 1; display: flex; align-items: center; justify-content: center;
    }
    .btn-borrar:hover { background: #E2857A; border-color: #E2857A; color: var(--negro); }
    .btn-borrar:disabled { opacity: 0.5; cursor: default; }
    .vacio { color: var(--humo); font-size: 14px; padding: 12px 0; }
  </style>
</head>
<body>
  <main class="container">
    <a class="volver" href="/admin/eventos">← Todos los eventos</a>

    {!evento && <p>Evento no encontrado.</p>}

    {evento && (
      <>
        <h1>{evento.nombre}</h1>
        <p class="meta">
          {evento.tipo === "carrera" ? "Carrera atlética" : "Cliente"}
          {evento.fecha && ` · ${evento.fecha}`}
        </p>

        <section class="panel">
          <h2>Código de acceso</h2>
          <div class="codigo-box">
            <code id="codigo">{evento.codigo_acceso}</code>
            <button id="btn-copiar">Copiar</button>
          </div>
          <a id="btn-whatsapp" class="btn-whatsapp" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M17.6 6.32A8.86 8.86 0 0 0 12.05 4a8.94 8.94 0 0 0-7.73 13.4L3 21l3.68-1.28a8.9 8.9 0 0 0 4.27 1.09h.02a8.94 8.94 0 0 0 6.63-14.5Zm-5.55 13.76a7.4 7.4 0 0 1-3.77-1.03l-.27-.16-2.24.78.75-2.18-.17-.28a7.44 7.44 0 1 1 13.8-3.92 7.4 7.4 0 0 1-7.4 7.4Zm4.06-5.56c-.22-.11-1.31-.65-1.51-.72-.2-.07-.35-.11-.5.11-.15.22-.57.72-.7.87-.13.15-.26.16-.48.05a6.06 6.06 0 0 1-1.78-1.1 6.7 6.7 0 0 1-1.23-1.53c-.13-.22-.01-.34.1-.45.1-.1.22-.26.33-.39.11-.13.15-.22.22-.37.07-.15.04-.28-.02-.39-.06-.11-.5-1.2-.68-1.65-.18-.43-.36-.37-.5-.38h-.43c-.15 0-.39.06-.59.28-.2.22-.77.75-.77 1.84s.79 2.14.9 2.29c.11.15 1.55 2.36 3.75 3.31.52.22.93.36 1.25.46.53.17 1 .15 1.38.09.42-.06 1.31-.53 1.49-1.05.18-.51.18-.95.13-1.05-.05-.1-.2-.16-.42-.27Z"/></svg>
            Enviar por WhatsApp
          </a>
          <p class="link-galeria">
            La persona entra en
            <a href="/galeria">hr-estudio-fotografia.vercel.app/galeria</a>, escribe el código, y
            ve y descarga {evento.tipo === "carrera" ? "sus" : "todas las"} fotos de este evento.
          </p>
        </section>

        <section class="panel">
          <h2>Subir fotos</h2>
          {evento.tipo === "carrera" && (
            <p class="link-galeria" style="margin-bottom:14px;">
              Este evento tiene búsqueda por selfie activada: cada foto que subas se analiza
              en tu navegador (gratis, sin servidor externo) para poder encontrar después en
              qué fotos aparece cada atleta.
            </p>
          )}
          <label class="dropzone" for="input-fotos">
            Haz clic para elegir fotos (puedes seleccionar varias a la vez, sin límite de peso por foto)
          </label>
          <input type="file" id="input-fotos" multiple accept="image/*" />
          <p class="estado-subida" id="estado-subida"></p>
          {evento.tipo === "carrera" && (
            <button class="btn-borrar-todo" id="btn-reindexar" type="button"
              style="margin-top:14px; background:none; border:1px solid var(--borde); color:var(--humo); padding:10px 16px; border-radius:4px; cursor:pointer; font-size:13px;">
              Indexar fotos pendientes
            </button>
          )}
        </section>

        <section class="panel">
          <h2 id="titulo-fotos">Fotos subidas ({fotos.length})</h2>
          <p class="vacio" id="mensaje-vacio" style={fotos.length > 0 ? "display:none;" : ""}>
            Todavía no hay fotos en este evento.
          </p>
          {fotos.length > 0 && (
            <div class="grid" id="grid-fotos">
              {fotos.map((f) => (
                <div class="foto-item" data-photo-id={f.id}>
                  <img src={f.thumb_url ?? ""} alt={f.nombre_archivo ?? ""} loading="lazy" />
                  <button class="btn-borrar" data-id={f.id} title="Borrar foto" type="button">✕</button>
                </div>
              ))}
            </div>
          )}
        </section>

        <section class="panel" style="border-color: rgba(226,133,122,0.35);">
          <h2 style="color:#E2857A;">Zona de peligro</h2>
          <p class="link-galeria" style="margin-bottom:14px;">
            Esto borra el evento y todas sus fotos de forma permanente. No se puede deshacer.
          </p>
          <button id="btn-borrar-evento" type="button"
            style="background:none; border:1px solid #E2857A; color:#E2857A; padding:10px 18px; border-radius:4px; cursor:pointer; font-size:13px;">
            Borrar este evento
          </button>
        </section>
      </>
    )}
  </main>

  <script define:vars={{
    eventId: id,
    esCarrera: evento?.tipo === "carrera",
    nombreEvento: evento?.nombre ?? "",
    codigoAcceso: evento?.codigo_acceso ?? "",
    codigoExpiraEn: evento?.codigo_expira_en ?? null,
  }}>
    // Este script solo pasa datos al módulo de abajo. Va aparte porque un
    // script con define:vars no puede usar "import" (Astro lo trata como
    // script en línea, sin empaquetar).
    window.__EVENT_ID__ = eventId;
    window.__ES_CARRERA__ = esCarrera;
    window.__NOMBRE_EVENTO__ = nombreEvento;
    window.__CODIGO_ACCESO__ = codigoAcceso;
    window.__CODIGO_EXPIRA_EN__ = codigoExpiraEn;
  </script>

  <script>
    import { createClient } from "@supabase/supabase-js";

    const eventId = window.__EVENT_ID__;
    const esCarrera = window.__ES_CARRERA__;
    // Llave pública (anon), segura de exponer: la autorización real de
    // cada subida la da el token de un solo uso que pedimos a nuestro
    // propio backend en cada foto, no esta llave.
    const supabase = createClient(
      import.meta.env.PUBLIC_SUPABASE_URL,
      import.meta.env.PUBLIC_SUPABASE_ANON_KEY
    );

    // ---------- face-api.js: modelos hospedados en /models, gratis ----------
    let modelosCargados = false;
    async function asegurarModelos() {
      if (modelosCargados) return;
      await faceapi.nets.tinyFaceDetector.loadFromUri("/models");
      await faceapi.nets.faceLandmark68Net.loadFromUri("/models");
      await faceapi.nets.faceRecognitionNet.loadFromUri("/models");
      modelosCargados = true;
    }

    async function extraerEmbeddingsDeArchivo(archivo) {
      const img = await faceapi.bufferToImage(archivo);
      const detecciones = await faceapi
        .detectAllFaces(img, new faceapi.TinyFaceDetectorOptions())
        .withFaceLandmarks()
        .withFaceDescriptors();
      return detecciones.map((d) => Array.from(d.descriptor));
    }

    async function extraerEmbeddingsDeUrl(url) {
      const img = await faceapi.fetchImage(url);
      const detecciones = await faceapi
        .detectAllFaces(img, new faceapi.TinyFaceDetectorOptions())
        .withFaceLandmarks()
        .withFaceDescriptors();
      return detecciones.map((d) => Array.from(d.descriptor));
    }

    async function guardarEmbeddings(photoId, embeddings) {
      await fetch("/api/admin/embeddings", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ photo_id: photoId, embeddings }),
      });
    }

    const btnCopiar = document.getElementById("btn-copiar");
    btnCopiar?.addEventListener("click", () => {
      const codigo = document.getElementById("codigo").textContent;
      navigator.clipboard.writeText(codigo);
      btnCopiar.textContent = "Copiado";
      setTimeout(() => (btnCopiar.textContent = "Copiar"), 1500);
    });

    // ---------- Mensaje de WhatsApp con el código y los pasos ----------
    function construirMensajeWhatsApp() {
      const nombreEvento = window.__NOMBRE_EVENTO__;
      const codigo = window.__CODIGO_ACCESO__;
      const expiraEn = window.__CODIGO_EXPIRA_EN__;
      const urlGaleria = `${window.location.origin}/galeria`;

      let pasos;
      if (esCarrera) {
        pasos =
          `1️⃣ Entra a ${urlGaleria}\n` +
          `2️⃣ Escribe tu código: *${codigo}*\n` +
          `3️⃣ Sube una selfie (de frente, buena luz) para encontrar tus fotos\n` +
          `4️⃣ Descárgalas una por una, todas juntas, o guárdalas directo en tu galería`;
      } else {
        pasos =
          `1️⃣ Entra a ${urlGaleria}\n` +
          `2️⃣ Escribe tu código: *${codigo}*\n` +
          `3️⃣ Descarga tus fotos, una por una, todas juntas, o guárdalas directo en tu galería`;
      }

      let vigencia;
      if (expiraEn) {
        const fecha = new Date(expiraEn);
        const fechaTexto = fecha.toLocaleDateString("es-MX", {
          day: "numeric",
          month: "long",
          year: "numeric",
        });
        vigencia = `📅 Tu código estará disponible hasta el *${fechaTexto}*.`;
      } else {
        vigencia = `📅 Tu código no tiene fecha de vencimiento.`;
      }

      return (
        `¡Hola! 👋 Aquí tienes el acceso a las fotos de *${nombreEvento}*.\n\n` +
        `${pasos}\n\n${vigencia}\n\n` +
        `Cualquier duda, escríbeme por aquí mismo. ¡Gracias por confiar en HR Estudio! 📸`
      );
    }

    const btnWhatsapp = document.getElementById("btn-whatsapp");
    if (btnWhatsapp) {
      btnWhatsapp.href = `https://wa.me/?text=${encodeURIComponent(construirMensajeWhatsApp())}`;
    }

    const input = document.getElementById("input-fotos");
    const estado = document.getElementById("estado-subida");

    input?.addEventListener("change", async () => {
      const archivos = Array.from(input.files || []);
      if (archivos.length === 0) return;

      let subidas = 0;

      for (let i = 0; i < archivos.length; i++) {
        const archivo = archivos[i];
        estado.className = "estado-subida";
        estado.textContent = `Subiendo ${i + 1}/${archivos.length}: ${archivo.name}...`;

        try {
          // 1. Pedimos permiso: un lugar y un token de un solo uso para
          //    subir este archivo directo a Supabase (sin pasar por Vercel).
          const resUrl = await fetch("/api/admin/upload-url", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ eventId, nombreArchivo: archivo.name }),
          });
          const datosUrl = await resUrl.json();
          if (!resUrl.ok) throw new Error(datosUrl.error || "No se pudo iniciar la subida");

          // 2. Subimos el archivo ORIGINAL directo a Supabase Storage.
          //    Esto puede pesar decenas de MB sin ningún problema: no toca
          //    nuestra función de Vercel para nada.
          const { error: errorSubida } = await supabase.storage
            .from("fotos")
            .uploadToSignedUrl(datosUrl.path, datosUrl.token, archivo);
          if (errorSubida) throw errorSubida;

          // 3. Avisamos a nuestro backend: genera el thumbnail y guarda el registro.
          const resConfirmar = await fetch("/api/admin/confirmar-foto", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              eventId,
              storageKey: datosUrl.storageKey,
              nombreArchivo: archivo.name,
            }),
          });
          const datosConfirmar = await resConfirmar.json();
          if (!resConfirmar.ok) throw new Error(datosConfirmar.error || "No se pudo procesar la foto");

          // 4. Si el evento tiene búsqueda por selfie activada, analizamos
          //    el rostro AQUÍ MISMO, con el archivo que ya tenemos en
          //    memoria (no hace falta volver a descargarlo de Storage).
          if (esCarrera) {
            estado.textContent = `Analizando rostros en "${archivo.name}"...`;
            try {
              await asegurarModelos();
              const embeddings = await extraerEmbeddingsDeArchivo(archivo);
              await guardarEmbeddings(datosConfirmar.foto.id, embeddings);
            } catch (e) {
              console.error("No se pudo indexar el rostro de", archivo.name, e);
            }
          }

          subidas++;
        } catch (e) {
          console.error("Error subiendo", archivo.name, e);
          estado.className = "estado-subida error";
          estado.textContent = `"${archivo.name}" falló: ${e.message || "error desconocido"}. Sigo con las demás...`;
          await new Promise((r) => setTimeout(r, 1400));
        }
      }

      if (subidas > 0) {
        estado.className = "estado-subida ok";
        estado.textContent = `${subidas} de ${archivos.length} foto(s) subida(s). Actualizando...`;
        setTimeout(() => window.location.reload(), 900);
      } else {
        estado.className = "estado-subida error";
        estado.textContent = "No se pudo subir ninguna foto. Revisa tu conexión e intenta de nuevo.";
      }
    });

    // ---------- Reindexar fotos existentes (botón manual) ----------
    const btnReindexar = document.getElementById("btn-reindexar");

    btnReindexar?.addEventListener("click", async () => {
      btnReindexar.disabled = true;
      const textoOriginal = btnReindexar.textContent;

      try {
        await asegurarModelos();

        const res = await fetch(`/api/admin/fotos?eventId=${eventId}&soloSinIndexar=true`);
        const data = await res.json();
        const pendientes = data.fotos ?? [];

        if (pendientes.length === 0) {
          btnReindexar.textContent = "No hay fotos pendientes";
          setTimeout(() => (btnReindexar.textContent = textoOriginal), 2000);
          return;
        }

        for (let i = 0; i < pendientes.length; i++) {
          btnReindexar.textContent = `Indexando ${i + 1}/${pendientes.length}...`;
          const foto = pendientes[i];
          if (!foto.thumbnail_url) continue;
          try {
            const embeddings = await extraerEmbeddingsDeUrl(foto.thumbnail_url);
            await guardarEmbeddings(foto.id, embeddings);
          } catch (e) {
            console.error("No se pudo indexar", foto.id, e);
          }
        }

        btnReindexar.textContent = "Listo";
        setTimeout(() => (btnReindexar.textContent = textoOriginal), 2000);
      } catch {
        btnReindexar.textContent = "Ocurrió un problema";
        setTimeout(() => (btnReindexar.textContent = textoOriginal), 2000);
      } finally {
        btnReindexar.disabled = false;
      }
    });

    // ---------- Borrar el evento completo ----------
    const btnBorrarEvento = document.getElementById("btn-borrar-evento");
    btnBorrarEvento?.addEventListener("click", async () => {
      const nombreEvento = window.__NOMBRE_EVENTO__;

      const escrito = prompt(
        `Esto borra "${nombreEvento}" Y TODAS SUS FOTOS de forma permanente. No se puede deshacer.\n\nPara confirmar, escribe el nombre exacto del evento:`
      );
      if (escrito === null) return;
      if (escrito.trim() !== nombreEvento) {
        alert("El nombre no coincide. No se borró nada.");
        return;
      }

      btnBorrarEvento.disabled = true;
      btnBorrarEvento.textContent = "Borrando...";

      try {
        const res = await fetch(`/api/admin/events/${eventId}`, { method: "DELETE" });
        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          alert(data.error ?? "No se pudo borrar el evento.");
          btnBorrarEvento.disabled = false;
          btnBorrarEvento.textContent = "Borrar este evento";
          return;
        }

        window.location.href = "/admin/eventos";
      } catch {
        alert("Ocurrió un problema de conexión al borrar.");
        btnBorrarEvento.disabled = false;
        btnBorrarEvento.textContent = "Borrar este evento";
      }
    });

    // ---------- Borrar una foto ----------
    document.getElementById("grid-fotos")?.addEventListener("click", async (e) => {
      const btn = e.target.closest(".btn-borrar");
      if (!btn) return;

      const photoId = btn.getAttribute("data-id");
      const confirmado = confirm("¿Borrar esta foto? No se puede deshacer.");
      if (!confirmado) return;

      const item = btn.closest(".foto-item");
      item.classList.add("borrando");
      btn.disabled = true;

      try {
        const res = await fetch(`/api/admin/fotos/${photoId}`, { method: "DELETE" });
        if (!res.ok) {
          item.classList.remove("borrando");
          btn.disabled = false;
          alert("No se pudo borrar la foto. Intenta de nuevo.");
          return;
        }

        item.remove();

        const grid = document.getElementById("grid-fotos");
        const restantes = grid ? grid.querySelectorAll(".foto-item").length : 0;
        document.getElementById("titulo-fotos").textContent = `Fotos subidas (${restantes})`;
        if (restantes === 0) {
          document.getElementById("mensaje-vacio").style.display = "block";
        }
      } catch {
        item.classList.remove("borrando");
        btn.disabled = false;
        alert("Ocurrió un problema de conexión al borrar.");
      }
    });
  </script>
</body>
</html>
